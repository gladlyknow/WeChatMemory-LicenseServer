[Unit]
Description=WeChat Memory License API
After=network-online.target
Wants=network-online.target
AssertPathExists=@WKM_RELEASE_DIR@/license_server/__main__.py

[Service]
Type=exec
User=wkm-license
Group=wkm-license
WorkingDirectory=@WKM_RELEASE_DIR@
EnvironmentFile=/etc/wechat-memory-license/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=@WKM_RELEASE_DIR@/.venv/bin/python @WKM_RELEASE_DIR@/scripts/service_preflight.py --env /etc/wechat-memory-license/service.env --manifest @WKM_RELEASE_DIR@/config/signing-public-keys.json
ExecStart=@WKM_RELEASE_DIR@/.venv/bin/python -m license_server --host 127.0.0.1 --port 9100 --threads 6
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/wechat-memory-license /var/log/wechat-memory-license

[Install]
WantedBy=multi-user.target
